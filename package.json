{
  "name": "beekeeping",
  "version": "0.0.0",
  "private": true,
  "description": "Double-entry bookkeeping for small businesses, with an agentic back office.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:migrate": "pnpm --filter @beekeeping/db run db:migrate",
    "db:start": "pnpm --filter @beekeeping/db run db:start",
    "db:stop": "pnpm --filter @beekeeping/db run db:stop",
    "db:url": "pnpm --filter @beekeeping/db run --silent db:url",
    "dev:demo": "pnpm --filter @beekeeping/web dev:demo",
    "evidence": "pnpm --filter @beekeeping/web evidence",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "seed:demo": "pnpm --filter @beekeeping/web seed:demo",
    "test": "vitest run --allowOnly=false",
    "test:e2e": "pnpm --filter @beekeeping/web test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc && pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "catalog:",
    "@types/estree": "1.0.9",
    "@types/node": "catalog:",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "catalog:"
  }
}
